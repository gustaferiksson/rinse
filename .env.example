# Copy to .env (git-ignored). Sourced by build.sh. Unset => ad-hoc build.
# The App Group is team-prefixed, so settings only persist in a team-signed build.
DEVELOPMENT_TEAM=XXXXXXXXXX
CODE_SIGN_IDENTITY="Developer ID Application"
# notarytool keychain profile for ./notarize.sh (see SHIPPING.md).
NOTARY_PROFILE=Rinse
